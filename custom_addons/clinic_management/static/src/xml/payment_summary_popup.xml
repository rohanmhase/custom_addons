<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentSummaryPopup" owl="1">
        <div class="popup" style="min-width: 50vw; border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">

            <header class="title" style="background-color: #714B67; color: white; padding: 15px; font-weight: bold; font-size: 18px;">
                Confirm Payment Summary
            </header>

            <main class="body" style="text-align: left; max-height: 55vh; overflow-y: auto; padding: 20px;">

                <div style="text-align: center; margin-bottom: 25px; padding: 15px; background-color: #f8f9fa; border-radius: 8px; border: 1px solid #e9ecef;">
                    <span style="font-size: 16px; color: #6c757d;">Total Amount</span><br/>
                    <span style="font-size: 34px; font-weight: bold; color: #28a745;">
                        <t t-esc="props.totalAmount"/>
                    </span>
                </div>

                <h5 style="margin-bottom: 10px; border-bottom: 2px solid #e9ecef; padding-bottom: 5px; color: #495057;">Order Lines</h5>
                <table class="table table-striped table-sm mb-4">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="props.orderlines" t-as="line" t-key="line.id">
                            <td style="vertical-align: middle;"><t t-esc="line.name"/></td>
                            <td class="text-center" style="vertical-align: middle;"><t t-esc="line.qty"/></td>
                            <td class="text-end" style="vertical-align: middle;"><t t-esc="line.price"/></td>
                        </tr>
                    </tbody>
                </table>

                <h5 style="margin-bottom: 10px; border-bottom: 2px solid #e9ecef; padding-bottom: 5px; color: #495057;">Payment Methods</h5>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Method</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="props.paymentlines" t-as="pline" t-key="pline.id">
                            <td style="vertical-align: middle;"><t t-esc="pline.name"/></td>
                            <td class="text-end" style="vertical-align: middle;"><t t-esc="pline.amount"/></td>
                        </tr>
                    </tbody>
                </table>

            </main>

            <!-- NEW: Styled footer with distinct buttons -->
            <footer class="footer" style="display: flex; justify-content: flex-end; gap: 15px; padding: 15px 20px; background-color: #f8f9fa; border-top: 1px solid #dee2e6;">
                <div class="button cancel" t-on-click="cancel" style="padding: 12px 25px; border-radius: 6px; border: 1px solid #ced4da; background-color: #ffffff; color: #495057; cursor: pointer; font-weight: bold; font-size: 16px;">
                    Cancel
                </div>
                <div class="button confirm highlight" t-on-click="confirm" style="padding: 12px 25px; border-radius: 6px; background-color: #28a745; color: white; cursor: pointer; font-weight: bold; font-size: 16px; border: none;">
                    Yes, Validate
                </div>
            </footer>

        </div>
    </t>
</templates>