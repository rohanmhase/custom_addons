<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_import_lines_button" model="ir.ui.view">
        <field name="name">account.move.form.import.lines.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="after">
                <button
                    type="action"
                    name="%(invoice_line_importer.action_import_invoice_lines_wizard)d"
                    string="Import Lines"
                    context="{'active_id': id, 'active_model': 'account.move'}"
                    invisible="state != 'draft'"
                    class="btn-secondary"
                    icon="fa-upload"
                />
            </xpath>

        </field>
    </record>

</odoo>