<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Stock Audit Snapshot Builder Cron
            - Runs daily at 00:00 IST (= 18:30 UTC previous day).
            - Self-healing: builds missing snapshots one by one until caught up.
            - On fresh install, first run at next 18:30 UTC backfills all history.
            - Timezone note: nextcall is stored in UTC by Odoo.
              18:30 UTC = 00:00 IST (India Standard Time, UTC+5:30).
        -->
        <record id="ir_cron_stock_audit_snapshot_builder" model="ir.cron">
            <field name="name">Stock Audit: Build Snapshots (00:00 IST)</field>
            <field name="model_id" ref="model_stock_audit_snapshot_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_build_snapshots()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(
                (DateTime.utcnow().replace(hour=18, minute=30, second=0, microsecond=0))
                if DateTime.utcnow().hour &lt; 18 or (DateTime.utcnow().hour == 18 and DateTime.utcnow().minute &lt; 30)
                else (DateTime.utcnow().replace(hour=18, minute=30, second=0, microsecond=0) + timedelta(days=1))
            )"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>