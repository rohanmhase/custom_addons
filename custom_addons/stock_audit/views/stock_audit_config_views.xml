<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_audit_config_form" model="ir.ui.view">
        <field name="name">stock.audit.config.form</field>
        <field name="model">stock.audit.config</field>
        <field name="arch" type="xml">
            <form string="Stock Audit Configuration" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Stock Audit Configuration</h1>
                    </div>
                    <group>
                        <group>
                            <field name="root_company_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="resolved_company_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Included Companies (Auto-Resolved)">
                            <field name="resolved_company_ids" nolabel="1" readonly="1">
                                <tree create="false" edit="false" delete="false">
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_audit_config" model="ir.actions.act_window">
        <field name="name">Stock Audit Configuration</field>
        <field name="res_model">stock.audit.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_stock_audit_config_singleton" model="ir.actions.server">
        <field name="name">Open Stock Audit Configuration</field>
        <field name="model_id" ref="model_stock_audit_config"/>
        <field name="state">code</field>
        <field name="code">
config = model.get_config()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Stock Audit Configuration',
    'res_model': 'stock.audit.config',
    'view_mode': 'form',
    'res_id': config.id,
    'target': 'current',
}
        </field>
    </record>

</odoo>