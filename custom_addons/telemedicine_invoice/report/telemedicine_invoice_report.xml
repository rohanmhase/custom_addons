<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_tm_invoice_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="config" t-value="env['telemedicine.import.config']._get_config()"/>
            <t t-set="line_data" t-value="o._get_report_line()"/>
            <t t-set="half_tax" t-value="o.amount_tax / 2.0"/>
            <t t-set="hsn_code" t-value="config.get_hsn_code()"/>

            <!-- HEADER: Company on Left, Customer on Right (No Logo) -->
            <div class="header">
                <div class="row text-sm" style="font-size: 13px; line-height: 1.3;">
                    <div class="col-6">
                        <span t-field="o.company_id.name" class="fw-bold"/><br/>
                        <span t-field="o.company_id.street" t-if="o.company_id.street"/><br t-if="o.company_id.street"/>
                        <span t-field="o.company_id.street2" t-if="o.company_id.street2"/><br t-if="o.company_id.street2"/>
                        <span t-field="o.company_id.city" t-if="o.company_id.city"/>
                        <span t-field="o.company_id.zip" t-if="o.company_id.zip"/><br/>
                        <span t-field="o.company_id.state_id.name" t-if="o.company_id.state_id"/>
                        <span t-field="o.company_id.state_id.code" t-if="o.company_id.state_id"/><br/>
                        <span t-field="o.company_id.country_id.name" t-if="o.company_id.country_id"/>
                    </div>
                    <div class="col-6 text-end">
                        <div t-field="o.customer_id.name" class="fw-bold" t-options='{"widget": "text"}'/>
                        <div t-if="o.customer_id.gstin">
                            GSTIN: <span t-field="o.customer_id.gstin"/>
                        </div>
                        <div t-if="o.place_of_supply">
                            Place of supply: <span t-field="o.place_of_supply"/>
                        </div>
                    </div>
                </div>
                <div class="border-bottom border-dark mt-2 mb-3"/>
            </div>

            <div class="page mt-2">
                <!-- Title: Tax Invoice / Bill of Supply -->
                <h2 class="mb-3">
                    <span t-out="o.get_document_title()"/>
                    <span t-field="o.name"/>
                </h2>

                <!-- Invoice Details -->
                <div id="informations" class="row mb-3" style="font-size: 14px;">
                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date">
                        <strong>Invoice Date:</strong><br/>
                        <span t-field="o.invoice_date"/>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date">
                        <strong>Due Date:</strong><br/>
                        <span t-field="o.invoice_date"/>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.purchase_order">
                        <strong>Source:</strong><br/>
                        <span t-field="o.purchase_order"/>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.name">
                        <strong>Reference:</strong><br/>
                        <span t-field="o.name"/>
                    </div>
                </div>

                <!-- Line Item Table -->
                <table class="table table-sm o_main_table table-borderless mt-3" name="invoice_line_table">
                    <thead>
                        <tr>
                            <th class="text-start"><span>Description</span></th>
                            <th class="text-start" t-if="hsn_code"><span>HSN/SAC</span></th>
                            <th class="text-end"><span>Quantity</span></th>
                            <th class="text-end"><span>Unit Price</span></th>
                            <th class="text-end"><span>Taxes</span></th>
                            <th class="text-end"><span>Amount</span></th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <tr>
                            <td><span t-out="line_data['name']"/></td>
                            <td t-if="hsn_code">
                                <span t-out="hsn_code"/>
                            </td>
                            <td class="text-end"><span>1.00</span></td>
                            <td class="text-end">
                                <span class="text-nowrap"
                                      t-out="line_data['price_unit']"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-out="f'{o.tax_percent:g}% GST' if o.tax_percent &gt; 0 else ''"/>
                            </td>
                            <td class="text-end o_price_total">
                                <span class="text-nowrap"
                                      t-out="line_data['price_subtotal']"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals Section -->
                <div class="clearfix mb-4">
                    <div id="right-elements" class="col-5 ms-5 d-inline-block float-end">
                        <div id="total" class="clearfix row">
                            <div class="ms-auto">
                                <table class="table table-sm table-borderless avoid-page-break-inside">
                                    <tr class="border-black o_subtotal">
                                        <td><strong>Before Tax Amt.</strong></td>
                                        <td class="text-end">
                                            <span t-out="o.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <!-- SGST & CGST Bifurcation -->
                                    <tr t-if="o.amount_tax &gt; 0">
                                        <td>
                                            SGST on <span t-out="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <span class="text-nowrap" t-out="half_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax &gt; 0">
                                        <td>
                                            CGST on <span t-out="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <span class="text-nowrap" t-out="half_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.rounding_adj != 0">
                                        <td>Rounding</td>
                                        <td class="text-end">
                                            <span t-out="o.rounding_adj"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="border-black o_total">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <span t-out="o.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Amount in Words -->
                        <div class="mb-2" t-if="o.amount_total_words">
                            <p class="text-end lh-sm">
                                Total amount in words: <br/>
                                <small class="text-muted lh-sm">
                                    <span t-out="o.amount_total_words"/>
                                </small>
                            </p>
                        </div>
                    </div>

                    <!-- Payment Communication & Narration -->
                    <div id="payment_term" class="clearfix">
                        <div class="mb-3" t-if="o.name">
                            <p name="payment_communication">
                                Payment Communication: <strong t-field="o.name"/>
                            </p>
                        </div>

                        <div class="text-muted mb-3" name="comment"
                             t-if="o.narration and config.show_narration_on_pdf"
                             style="page-break-inside: avoid;">
                            <span t-field="o.narration"/>
                        </div>
                    </div>
                </div>

                <!-- HSN Summary Table -->
                <div t-if="hsn_code" class="mt-4" style="page-break-inside: avoid; clear: both;">
                    <h3 class="text-center mb-3">HSN Summary</h3>
                    <table class="table table-sm table-borderless">
                        <thead>
                            <tr>
                                <th>HSN/SAC</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Rate %</th>
                                <th class="text-end">Taxable Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span t-out="hsn_code"/></td>
                                <td class="text-end">1.0 (Sessions)</td>
                                <td class="text-end"><span t-out="f'{o.tax_percent:g}'"/></td>
                                <td class="text-end">
                                    <span t-out="o.amount_untaxed"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="report_tm_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="env.user.lang"/>
                <t t-call="telemedicine_invoice.report_tm_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>