<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telemedicine_invoice_form" model="ir.ui.view">
        <field name="name">telemedicine.invoice.form</field>
        <field name="model">telemedicine.invoice</field>
        <field name="arch" type="xml">
            <form string="Telemedicine Invoice">
                <header>
                    <button name="action_post" string="Post"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'posted'"/>
                    <button name="action_print_invoice" string="Print"
                            type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="invoice_date"/>
                            <field name="purchase_order"/>
                        </group>
                        <group>
                            <field name="place_of_supply"/>
                            <field name="delivered"/>
                            <field name="tax_percent"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <group>
                            <field name="amount_total"/>
                            <field name="amount_untaxed"/>
                        </group>
                        <group>
                            <field name="amount_tax"/>
                            <field name="rounding_adj"/>
                            <field name="amount_printed_total"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="narration" nolabel="1"/>
                    </group>
                    <group>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                        <field name="currency_id"
                               groups="base.group_multi_currency"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telemedicine_invoice_tree" model="ir.ui.view">
        <field name="name">telemedicine.invoice.tree</field>
        <field name="model">telemedicine.invoice</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="invoice_date"/>
                <field name="place_of_supply"/>
                <field name="amount_total"/>
                <field name="delivered"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_telemedicine_invoice_search" model="ir.ui.view">
        <field name="name">telemedicine.invoice.search</field>
        <field name="model">telemedicine.invoice</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="purchase_order"/>
                <filter name="posted" string="Posted"
                        domain="[('state','=','posted')]"/>
                <filter name="draft" string="Draft"
                        domain="[('state','=','draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer"
                            context="{'group_by':'customer_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by':'invoice_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_telemedicine_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">telemedicine.invoice</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
