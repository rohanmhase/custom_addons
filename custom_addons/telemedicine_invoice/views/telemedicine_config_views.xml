<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telemedicine_import_config_form" model="ir.ui.view">
        <field name="name">telemedicine.import.config.form</field>
        <field name="model">telemedicine.import.config</field>
        <field name="arch" type="xml">
            <form string="Telemedicine Config">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="default_tax_percent"/>
                        </group>
                        <group string="Invoice Line">
                            <field name="invoice_product_id"/>
                        </group>
                    </group>
                    <group string="PDF Options">
                        <field name="show_narration_on_pdf"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telemedicine_import_config_tree" model="ir.ui.view">
        <field name="name">telemedicine.import.config.tree</field>
        <field name="model">telemedicine.import.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="invoice_product_id"/>
                <field name="default_tax_percent"/>
                <field name="show_narration_on_pdf"/>
            </tree>
        </field>
    </record>

    <record id="action_telemedicine_config" model="ir.actions.act_window">
        <field name="name">Telemedicine Settings</field>
        <field name="res_model">telemedicine.import.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>