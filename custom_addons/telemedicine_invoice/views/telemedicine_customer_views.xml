<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telemedicine_customer_form" model="ir.ui.view">
        <field name="name">telemedicine.customer.form</field>
        <field name="model">telemedicine.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_customer_id"/>
                            <field name="gstin"/>
                        </group>
                        <group>
                            <field name="place_of_supply"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telemedicine_customer_tree" model="ir.ui.view">
        <field name="name">telemedicine.customer.tree</field>
        <field name="model">telemedicine.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="external_customer_id"/>
                <field name="place_of_supply"/>
                <field name="gstin"/>
            </tree>
        </field>
    </record>

    <record id="action_telemedicine_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">telemedicine.customer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
