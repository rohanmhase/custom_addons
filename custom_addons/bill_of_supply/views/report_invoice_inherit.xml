<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit base invoice report with high priority so it wins over l10n_in -->
    <template id="report_invoice_document_bill_of_supply"
              inherit_id="account.report_invoice_document"
              priority="100">

        <!-- Replace the whole title block -->
        <xpath expr="//h2" position="replace">
            <h2>
                <span t-if="proforma">PROFORMA </span>

                <!-- Customer Invoice / Bill of Supply -->
                <t t-if="o.move_type == 'out_invoice'">
                    <!-- Only real non-zero tax amount => Tax Invoice -->
                    <t t-set="has_tax"
                       t-value="bool(o.currency_id and not o.currency_id.is_zero(o.amount_tax)) if o.currency_id else bool(o.amount_tax)"/>
                    <t t-set="doc_title"
                       t-value="'Tax Invoice' if has_tax else 'Bill of Supply'"/>

                    <span t-if="o.state == 'posted'"><t t-out="doc_title"/></span>
                    <span t-elif="o.state == 'draft'">Draft <t t-out="doc_title"/></span>
                    <span t-elif="o.state == 'cancel'">Cancelled <t t-out="doc_title"/></span>
                </t>

                <!-- Credit Notes -->
                <t t-elif="o.move_type == 'out_refund'">
                    <span t-if="o.state == 'posted'">Credit Note</span>
                    <span t-elif="o.state == 'draft'">Draft Credit Note</span>
                    <span t-elif="o.state == 'cancel'">Cancelled Credit Note</span>
                </t>

                <!-- Vendor -->
                <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
                <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>

                <span t-if="o.name != '/'"> <span t-field="o.name"/></span>
            </h2>
        </xpath>

        <!-- Payment method block (unchanged logic) -->
        <xpath expr="//i[hasclass('oe_payment_label')]" position="replace">
            <i class="oe_form_field text-end oe_payment_label">
                Paid on
                <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/>

                <t t-set="payment_move"
                   t-value="o.env['account.move'].browse(payment_vals.get('move_id'))"/>
                <t t-set="method_name" t-value="False"/>

                <t t-if="payment_move and 'pos_payment_ids' in payment_move._fields and payment_move.pos_payment_ids">
                    <t t-set="method_name"
                       t-value="', '.join(payment_move.pos_payment_ids.mapped('payment_method_id.name'))"/>
                </t>

                <t t-if="not method_name and payment_move and payment_move.journal_id">
                    <t t-set="method_name" t-value="payment_move.journal_id.name"/>
                </t>

                <t t-if="method_name">
                    using <span t-out="method_name"/>
                </t>
            </i>
        </xpath>

    </template>

</odoo>