<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Override 1: Standard Account Invoice Template -->
    <!-- ============================================ -->
    <template id="report_invoice_document_bill_of_supply"
              inherit_id="account.report_invoice_document">

        <xpath expr="//h2" position="replace">
            <h2>
                <span t-if="not proforma"></span>
                <span t-else="">PROFORMA</span>

                <t t-if="o.move_type == 'out_invoice'">
                    <t t-set="is_pos_invoice" t-value="'pos_order_ids' in o._fields and o.pos_order_ids"/>
                    <t t-set="doc_title" t-value="'Bill of Supply' if is_pos_invoice else 'Tax Invoice'"/>
                    <span t-if="o.state == 'posted'"><t t-out="doc_title"/></span>
                    <span t-elif="o.state == 'draft'">Draft <t t-out="doc_title"/></span>
                    <span t-elif="o.state == 'cancel'">Cancelled <t t-out="doc_title"/></span>
                </t>

                <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Credit Note</span>
                <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note</span>
                <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note</span>
                <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
                <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>

                <span t-if="o.name != '/'" t-field="o.name">INV/2023/0001</span>
            </h2>
        </xpath>

        <xpath expr="//i[hasclass('oe_payment_label')]" position="replace">
            <i class="oe_form_field text-end oe_payment_label">
                Paid on <t t-out="payment_vals['date']" t-options='{"widget": "date"}'>2021-09-19</t>
                <t t-set="payment_move" t-value="o.env['account.move'].browse(payment_vals.get('move_id'))"/>
                <t t-set="method_name" t-value="False"/>
                <t t-if="payment_move and 'pos_payment_ids' in payment_move._fields">
                    <t t-set="pos_pays" t-value="payment_move.pos_payment_ids"/>
                    <t t-if="pos_pays">
                        <t t-set="method_name" t-value="', '.join(pos_pays.mapped('payment_method_id.name'))"/>
                    </t>
                </t>
                <t t-if="not method_name and payment_move and payment_move.journal_id">
                    <t t-set="method_name" t-value="payment_move.journal_id.name"/>
                </t>
                <t t-if="method_name">
                    using <span t-out="method_name">Cash</span>
                </t>
            </i>
        </xpath>

    </template>

</odoo>