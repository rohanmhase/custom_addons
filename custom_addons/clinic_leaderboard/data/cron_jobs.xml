<odoo>
    <data noupdate="1">
        <record id="ir_cron_update_clinic_leaderboard" model="ir.cron">
            <field name="name">Clinic Leaderboard: Daily Update</field>
            <field name="model_id" ref="model_clinic_daily_leaderboard"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_leaderboard()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="ir_cron_update_rs_leaderboard" model="ir.cron">
            <field name="name">RS Metrics Leaderboard: Daily Update</field>
            <field name="model_id" ref="model_clinic_rs_leaderboard"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_rs_leaderboard()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>