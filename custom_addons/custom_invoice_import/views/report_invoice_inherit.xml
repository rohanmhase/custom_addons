<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Invoice body: flag + narration + medicine list            -->
    <!-- ========================================================= -->
    <template id="report_invoice_document_inherit_teleconsult"
              inherit_id="account.report_invoice_document">

        <!-- Flag for header layouts: hide logo only when teleconsult + toggle OFF -->
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="tc_config"
               t-value="o.env['online.import.config'].search([('company_id', '=', o.company_id.id)], limit=1)
                        or o.env['online.import.config'].search([], limit=1)"/>
            <t t-set="is_teleconsult"
               t-value="o.env['teleconsult.invoice.line'].search_count([('move_id', '=', o.id)]) &gt; 0"/>
            <t t-set="hide_company_logo"
               t-value="is_teleconsult and tc_config and not tc_config.show_company_logo"/>
        </xpath>

        <!-- Suppress static narration on teleconsult invoices only -->
        <xpath expr="//div[@name='comment']" position="replace">
            <div class="text-muted mb-3"
                 t-attf-style="#{'text-align:justify;text-justify:inter-word;' if o.company_id.terms_type != 'html' else ''}"
                 t-if="not is_teleconsult and not is_html_empty(o.narration)"
                 name="comment">
                <span t-field="o.narration"/>
            </div>
        </xpath>

        <!-- Medicine list directly below Payment Communication -->
        <xpath expr="//p[@name='payment_communication']" position="after">
            <t t-if="tc_config and tc_config.show_items_in_notes">
                <t t-set="tc_lines"
                   t-value="o.env['teleconsult.invoice.line'].search([('move_id', '=', o.id)])"/>
                <div t-if="tc_lines" class="mt-3" style="page-break-inside: avoid;">
                    <strong>Medicines / Items:</strong>
                    <ul class="list-unstyled mb-0 ms-2">
                        <t t-foreach="tc_lines" t-as="tl">
                            <li>
                                <span t-out="tl.product_name"/>
                                x
                                <span t-out="int(tl.quantity) if tl.quantity == int(tl.quantity) else tl.quantity"/>
                            </li>
                        </t>
                    </ul>
                </div>
            </t>
        </xpath>

    </template>

    <!-- ========================================================= -->
    <!-- Hide logo in layouts only when hide_company_logo is True  -->
    <!-- ========================================================= -->

    <template id="external_layout_standard_hide_logo_teleconsult"
              inherit_id="web.external_layout_standard">
        <xpath expr="//img[@t-if='company.logo']" position="attributes">
            <attribute name="t-if">company.logo and not hide_company_logo</attribute>
        </xpath>
    </template>

    <template id="external_layout_boxed_hide_logo_teleconsult"
              inherit_id="web.external_layout_boxed">
        <xpath expr="//img[@t-if='company.logo']" position="attributes">
            <attribute name="t-if">company.logo and not hide_company_logo</attribute>
        </xpath>
    </template>

    <template id="external_layout_bold_hide_logo_teleconsult"
              inherit_id="web.external_layout_bold">
        <xpath expr="//img[@t-if='company.logo']" position="attributes">
            <attribute name="t-if">company.logo and not hide_company_logo</attribute>
        </xpath>
    </template>

    <template id="external_layout_striped_hide_logo_teleconsult"
              inherit_id="web.external_layout_striped">
        <xpath expr="//img[@t-if='company.logo']" position="attributes">
            <attribute name="t-if">company.logo and not hide_company_logo</attribute>
        </xpath>
    </template>

</odoo>