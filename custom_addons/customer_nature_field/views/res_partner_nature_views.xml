<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View (editable inline) -->
    <record id="view_res_partner_nature_tree" model="ir.ui.view">
        <field name="name">res.partner.nature.tree</field>
        <field name="model">res.partner.nature</field>
        <field name="arch" type="xml">
            <tree string="Customer Nature" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_res_partner_nature" model="ir.actions.act_window">
        <field name="name">Customer Nature</field>
        <field name="res_model">res.partner.nature</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Customer Nature tag
            </p>
        </field>
    </record>

    <!-- Menu: Contacts → Configuration → Customer Nature -->
    <menuitem id="menu_res_partner_nature"
              name="Customer Nature"
              parent="contacts.res_partner_menu_config"
              action="action_res_partner_nature"
              sequence="50"/>

</odoo>