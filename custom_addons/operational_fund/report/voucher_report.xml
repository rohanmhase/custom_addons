<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_op_fund_voucher" model="ir.actions.report">
        <field name="name">Disbursement Voucher</field>
        <field name="model">operational.fund.disbursement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">operational_fund.report_voucher_template</field>
        <field name="report_file">operational_fund.report_voucher_template</field>
        <field name="print_report_name">'Voucher - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_operational_fund_disbursement"/>
        <field name="binding_type">report</field>
        <field name="attachment_use">True</field>
        <field name="attachment">(object.state in ('approved', 'paid', 'refund_requested', 'refunded')) and ('Voucher_' + object.name.replace('/', '_') + '.pdf')</field>
    </record>

    <template id="report_voucher_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #212529;">

                        <!-- Header Banner -->
                        <table style="width: 100%; border-bottom: 2px solid #dee2e6; margin-bottom: 15px; padding-bottom: 10px;">
                            <tr>
                                <td style="width: 60%; vertical-align: top;">
                                    <h2 style="font-weight: bold; margin: 0; color: #1a252f; font-size: 20px;">PAYMENT DISBURSEMENT VOUCHER</h2>
                                    <div style="color: #6c757d; font-size: 13px; margin-top: 4px;">
                                        Branch: <strong style="color: #212529;"><t t-esc="doc.clinic_id.name"/></strong>
                                    </div>
                                </td>
                                <td style="width: 40%; text-align: right; vertical-align: top;">
                                    <h4 style="font-weight: bold; color: #6c757d; margin: 0 0 6px 0; font-size: 15px;"><t t-esc="doc.name"/></h4>
                                    <span t-if="doc.state == 'draft'" style="padding: 4px 10px; background-color: #f8f9fa; border: 1px solid #ccc; font-weight: bold; border-radius: 3px;">DRAFT</span>
                                    <span t-if="doc.state == 'waiting'" style="padding: 4px 10px; background-color: #f0ad4e; color: white; font-weight: bold; border-radius: 3px;">WAITING APPROVAL</span>
                                    <span t-if="doc.state == 'approved'" style="padding: 4px 10px; background-color: #0275d8; color: white; font-weight: bold; border-radius: 3px;">APPROVED (UNPAID)</span>
                                    <span t-if="doc.state == 'paid'" style="padding: 4px 10px; background-color: #5cb85c; color: white; font-weight: bold; border-radius: 3px;">PAID</span>
                                    <span t-if="doc.state == 'rejected'" style="padding: 4px 10px; background-color: #d9534f; color: white; font-weight: bold; border-radius: 3px;">REJECTED</span>
                                    <span t-if="doc.state == 'refunded'" style="padding: 4px 10px; background-color: #292b2c; color: white; font-weight: bold; border-radius: 3px;">REFUNDED</span>
                                </td>
                            </tr>
                        </table>

                        <!-- Cross-Cluster Notice -->
                        <div t-if="doc.is_cross_cluster_visit" style="padding: 8px 12px; margin-bottom: 15px; border-left: 4px solid #d9534f; background-color: #fdf7f7; color: #d9534f;">
                            <strong>Cross-Cluster Alert:</strong> Patient is registered outside this clinic's home cluster.
                        </div>

                        <!-- 2-Column Meta & Banking Information -->
                        <table style="width: 100%; margin-bottom: 20px;" cellspacing="10">
                            <tr>
                                <td style="width: 50%; vertical-align: top; border: 1px solid #dee2e6; border-radius: 4px; padding: 12px; background-color: #fafafa;">
                                    <div style="font-size: 11px; text-transform: uppercase; color: #6c757d; font-weight: bold; border-bottom: 1px solid #eee; padding-bottom: 4px; margin-bottom: 8px;">Voucher Summary</div>
                                    <table style="width: 100%; font-size: 12px;">
                                        <tr>
                                            <td style="color: #6c757d; width: 40%; padding: 3px 0;">Creation Date:</td>
                                            <td style="font-weight: bold;"><t t-esc="doc.date"/></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #6c757d; padding: 3px 0;">Approval Date:</td>
                                            <td style="font-weight: bold;"><t t-esc="doc.approval_date or 'Pending'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #6c757d; padding: 3px 0;">Category:</td>
                                            <td style="font-weight: bold;"><t t-esc="doc.display_category"/></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #6c757d; padding: 3px 0;">Prepared By:</td>
                                            <td style="font-weight: bold;"><t t-esc="doc.created_by_name or 'System'"/></td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="width: 50%; vertical-align: top; border: 1px solid #dee2e6; border-radius: 4px; padding: 12px; background-color: #fafafa;">
                                    <div style="font-size: 11px; text-transform: uppercase; color: #6c757d; font-weight: bold; border-bottom: 1px solid #eee; padding-bottom: 4px; margin-bottom: 8px;">Payee &amp; Banking Details</div>
                                    <table style="width: 100%; font-size: 12px;">
                                        <tr>
                                            <td style="color: #6c757d; width: 40%; padding: 3px 0;">Payee Name:</td>
                                            <td style="font-weight: bold;"><t t-esc="doc.payee_display"/></td>
                                        </tr>
                                        <tr t-if="doc.therapist_ved_number">
                                            <td style="color: #6c757d; padding: 3px 0;">VED Number:</td>
                                            <td><t t-esc="doc.therapist_ved_number"/></td>
                                        </tr>
                                        <tr t-if="doc.therapist_phone">
                                            <td style="color: #6c757d; padding: 3px 0;">Phone:</td>
                                            <td><t t-esc="doc.therapist_phone"/></td>
                                        </tr>
                                        <tr t-if="doc.bank_account_number">
                                            <td style="color: #6c757d; padding: 3px 0;">Bank &amp; Account:</td>
                                            <td>
                                                <t t-esc="doc.bank_name or 'Bank'"/><br/>
                                                <strong style="font-family: monospace;"><t t-esc="doc.bank_account_number"/></strong>
                                                (<t t-esc="doc.bank_ifsc_code"/>)
                                            </td>
                                        </tr>
                                        <tr t-if="doc.utr_reference">
                                            <td style="color: #6c757d; padding: 3px 0;">Bank UTR Ref:</td>
                                            <td style="font-weight: bold; color: #28a745; font-family: monospace;"><t t-esc="doc.utr_reference"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Main Financial Table -->
                        <table class="table table-bordered mb-4" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f8f9fa; font-size: 11px; text-transform: uppercase;">
                                    <th style="width: 25%; padding: 8px; border: 1px solid #dee2e6;">Expense Head</th>
                                    <th style="width: 55%; padding: 8px; border: 1px solid #dee2e6;">Operational Details &amp; Purpose</th>
                                    <th style="width: 20%; padding: 8px; border: 1px solid #dee2e6; text-align: right;">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; vertical-align: top;">
                                        <strong style="color: #1a252f;"><t t-esc="doc.display_category"/></strong>
                                        <div t-if="doc.office_expense_type" style="color: #6c757d; font-size: 11px; margin-top: 4px;">
                                            Type: <t t-esc="doc.office_expense_type.replace('_', ' ').title()"/>
                                        </div>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; vertical-align: top;">
                                        <div style="margin-bottom: 6px;">
                                            <strong>Purpose: </strong>
                                            <t t-if="doc.description">
                                                <t t-esc="doc.description"/>
                                            </t>
                                            <t t-else="">
                                                <span style="color: #6c757d; font-style: italic;">No specific narration entered.</span>
                                            </t>
                                        </div>
                                        <div t-if="doc.other_expense_details" style="font-size: 11px; color: #6c757d; margin-bottom: 4px;">
                                            <strong>Expense Detail:</strong> <t t-esc="doc.other_expense_details"/>
                                        </div>
                                        <div t-if="doc.travel_type == 'c2c' or doc.category == 'clinic_to_clinic'" style="padding: 6px; border: 1px solid #dee2e6; border-radius: 3px; background-color: #f8f9fa; font-size: 11px; margin-bottom: 6px;">
                                            <strong>Inter-Clinic Transfer:</strong>
                                            <t t-esc="doc.from_clinic_id.name"/> &amp;rarr; <t t-esc="doc.to_clinic_id.name"/>
                                            <span style="padding: 2px 6px; background-color: #6c757d; color: white; border-radius: 2px; margin-left: 5px;"><t t-esc="doc.therapist_type or doc.therapist_role"/></span>
                                        </div>
                                        <div t-if="doc.show_home_visit or doc.category == 'home_visit_travel'" style="padding: 6px; border: 1px solid #dee2e6; border-radius: 3px; background-color: #f8f9fa; font-size: 11px;">
                                            <div style="font-weight: bold; color: #6c757d; margin-bottom: 2px;">Home Visit Verification:</div>
                                            <div><strong>MRN:</strong> <t t-esc="doc.home_visit_mrn_search"/> | <strong>Patient:</strong> <t t-esc="doc.home_visit_patient_name"/></div>
                                            <div><strong>Phone:</strong> <t t-esc="doc.home_visit_patient_phone"/> | <strong>Clinic:</strong> <t t-esc="doc.home_visit_patient_clinic"/></div>
                                        </div>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; vertical-align: top; text-align: right; font-weight: bold; font-size: 14px;">
                                        <t t-esc="'%.2f' % doc.amount"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f8f9fa;">
                                    <td colspan="2" style="padding: 8px; border: 1px solid #dee2e6; text-align: right; font-weight: bold; text-transform: uppercase;">Total Payable</td>
                                    <td style="padding: 8px; border: 1px solid #dee2e6; text-align: right; font-weight: bold; font-size: 16px; color: #1a252f;">
                                        <t t-esc="'%.2f' % doc.amount"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Narration / Debit Ref Bar -->
                        <div t-if="doc.debit_narr" style="padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; background-color: #f8f9fa; font-size: 12px; margin-bottom: 25px;">
                            <strong>Debit Narration:</strong> <span style="font-family: monospace;"><t t-esc="doc.debit_narr"/></span>
                        </div>

                        <!-- 3-Box Authorization Section (Fully crash-proofed) -->
                        <table style="width: 100%; text-align: center; margin-top: 40px; border-spacing: 15px 0; border-collapse: separate;">
                            <tr>
                                <td style="width: 33.3%; border: 1px solid #dee2e6; border-radius: 5px; padding: 15px; vertical-align: top;">
                                    <div style="color: #6c757d; font-size: 11px; text-transform: uppercase; font-weight: bold; margin-bottom: 50px;">1. Prepared By</div>
                                    <div style="border-top: 1px solid #dee2e6; padding-top: 10px; font-weight: bold;">
                                        <t t-esc="doc.created_by_name or 'Staff Member'"/>
                                    </div>
                                </td>
                                <td style="width: 33.3%; border: 1px solid #dee2e6; border-radius: 5px; padding: 15px; vertical-align: top;">
                                    <div style="color: #6c757d; font-size: 11px; text-transform: uppercase; font-weight: bold; margin-bottom: 50px;">2. Approved By</div>
                                    <div style="border-top: 1px solid #dee2e6; padding-top: 10px; font-weight: bold;">
                                        Fund Manager / Controller
                                    </div>
                                </td>
                                <td style="width: 33.3%; border: 1px solid #dee2e6; border-radius: 5px; padding: 15px; vertical-align: top;">
                                    <div style="color: #6c757d; font-size: 11px; text-transform: uppercase; font-weight: bold; margin-bottom: 50px;">3. Payee Acknowledgment</div>
                                    <div style="border-top: 1px solid #dee2e6; padding-top: 10px; font-weight: bold;">
                                        <t t-esc="doc.payee_display"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>