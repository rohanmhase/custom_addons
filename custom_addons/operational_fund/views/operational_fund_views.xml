    <record id="view_op_fund_approval_rule_form" model="ir.ui.view">
        <field name="name">operational.fund.approval.rule.form</field>
        <field name="model">operational.fund.approval.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Routing Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active == True"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Reject Travel > ₹50,000"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="1. Triggers (IF)">
                            <div class="alert alert-info" role="alert">
                                <strong>Condition Builder:</strong> Define the exact parameters for when this rule should execute. If left empty, this rule will apply to ALL vouchers.
                            </div>
                            <field name="model_id" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="domain" widget="domain" options="{'model': 'model_name'}" style="min-height: 200px;"/>
                        </page>
                        <page string="2. Outcomes (THEN)">
                            <group>
                                <field name="action_type" widget="radio"/>
                            </group>
                            <group invisible="action_type != 'require_approval'">
                                <field name="approver_ids" widget="many2many_tags_avatar" placeholder="Select mandatory approvers..."/>
                            </group>
                            <group invisible="action_type != 'block'">
                                <field name="block_message" placeholder="Provide a reason to the user as to why this voucher is structurally blocked..."/>
                            </group>
                            <group string="Auditing &amp; Notifications">
                                <field name="cc_user_ids" widget="many2many_tags_avatar" placeholder="These users will be silently added as followers..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_op_fund_approval_rule_tree" model="ir.ui.view">
        <field name="name">operational.fund.approval.rule.tree</field>
        <field name="model">operational.fund.approval.rule</field>
        <field name="arch" type="xml">
            <tree string="Approval Rules" decoration-muted="not active">
