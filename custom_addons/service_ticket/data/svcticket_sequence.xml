<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ticket" model="ir.sequence">
            <field name="name">Service Ticket</field>
            <field name="code">svcticket.ticket</field>
            <field name="prefix">TKT-%(year)s-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_po" model="ir.sequence">
            <field name="name">Ticket PO</field>
            <field name="code">svcticket.po</field>
            <field name="prefix">PO-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
