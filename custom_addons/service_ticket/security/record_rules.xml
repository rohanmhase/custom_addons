<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- User: own tickets + anything raised at a clinic they are a contact for -->
        <record id="rule_ticket_user" model="ir.rule">
            <field name="name">Ticket: mine, my team, or my location</field>
            <field name="model_id" ref="model_svcticket_ticket"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|',
                ('reporter_id', '=', user.id),
                ('assignee_ids', 'in', [user.id]),
                ('location_id.contact_person_ids', 'in', [user.id]),
                ('current_user_id', '=', user.id),
                ('current_approver_ids.user_id', '=', user.id),
                ('current_team_id.member_ids', 'in', [user.id]),
                ('current_team_id.lead_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_user'))]"/>
        </record>

        <!-- Moderator: every ticket (they work the whole flow across teams) -->
        <record id="rule_ticket_moderator" model="ir.rule">
            <field name="name">Ticket: moderator sees all</field>
            <field name="model_id" ref="model_svcticket_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_moderator'))]"/>
        </record>

        <!-- Administrator: everything -->
        <record id="rule_ticket_manager" model="ir.rule">
            <field name="name">Ticket: administrator</field>
            <field name="model_id" ref="model_svcticket_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
        </record>

        <!-- POs: moderators and admins only -->
        <record id="rule_po_moderator" model="ir.rule">
            <field name="name">PO: moderators</field>
            <field name="model_id" ref="model_svcticket_po"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_moderator'))]"/>
        </record>

    </data>
</odoo>
