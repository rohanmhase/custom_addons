<odoo>
    <record id="view_patient_enrollment_tree" model="ir.ui.view">
        <field name="name">clinic.patient.enrollment.tree</field>
        <field name="model">patient.enrollment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="enrollment_date"/>
                <field name="enrollment_type"/>
                <field name="enrolled_for"/>
                <field name="total_sessions" string="Total Sessions"/>
                <field name="remaining_sessions"/>
                <field name="used_sessions" string="Used Sessions"/>
                <field name="state"/>
                <field name="payment_state"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_clinic_enrollment_dashboard_tree" model="ir.ui.view">
        <field name="name">clinic.enrollment.dashboard.tree</field>
        <field name="model">patient.enrollment</field>

        <!-- ADD THIS LINE: High priority hides it from standard menus -->
        <field name="priority" eval="999"/>

        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="patient_id" string="Patient Name"/>
                <field name="enrolled_for" string="Enrolled For"/>
                <field name="total_sessions" string="Total Session"/>
                <field name="total_amount" string="Total Amount" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_enrollment_form" model="ir.ui.view">
        <field name="name">clinic.patient.enrollment.form</field>
        <field name="model">patient.enrollment</field>
        <field name="arch" type="xml">
            <form string="Patient Enrollment" delete="false">
                <header>

                    <button name="action_open_bill_popup"
                            string="Create Bill"
                            type="object"
                            class="btn-primary"
                            invisible="payment_state == 'paid'"/>
                    <button name="action_mark_as_paid"
                            type="object"
                            string="Mark as Paid"
                            class="btn-primary"
                            invisible="payment_state == 'paid'"
                            groups="clinic_management.group_franchise_billing"/>
                    <field name="payment_state"
                           widget="statusbar"/>

                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="enrollment_date" readonly="1"/>
                            <field name="enrollment_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Enrollment For">
                            <field name="pain_knee"/>
                            <field name="pain_spine"/>
                            <field name="pain_other"/>
                            <field name="pain_multi"/>
                            <field name="enrolled_for" readonly="1"/>
                        </group>
                    </group>

                    <group string="Enrollment Summary">
                        <group>
                            <field name="total_amount" readonly="1"/>
                            <field name="total_sessions" readonly="1" string="Total Sessions"/>
                        </group>
                        <group>
                            <field name="used_sessions" readonly="1" string="Used Sessions"/>
                            <field name="remaining_sessions" readonly="1" string="Remaining"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Enrollment Services">
                            <field name="line_ids" context="{'show_custom_regeneration_name': True}">

                                <tree string="Enrollment Lines">
                                    <field name="service_config_id" column_invisible="1"/>
                                    <field name="quantity_mode" column_invisible="1"/>
                                    <field name="show_total_amount" column_invisible="1"/>
                                    <field name="show_unit_amount" column_invisible="1"/>
                                    <field name="service_product_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="total_amount" readonly="1" force_save="1"/>
                                    <field name="pos_qty" readonly="1" force_save="1"/>
                                    <field name="used_sessions" readonly="1" force_save="1" optional="hide"/>
                                    <field name="therapy_amount" readonly="1" force_save="1" optional="hide"/>
                                </tree>
                                <form string="Enrollment Service Line">
                                    <sheet>
                                        <div style="font-size:18px; padding-bottom: 10px; font-weight: bold;">Service
                                            Details
                                        </div>
                                        <group>
                                            <group>
                                                <field name="service_config_id" invisible="1"/>
                                                <field name="quantity_mode" invisible="1"/>
                                                <field name="show_total_amount" invisible="1"/>
                                                <field name="show_unit_amount" invisible="1"/>
                                                <field name="service_product_id"
                                                       options="{'no_create': True, 'no_open': True}"
                                                       context="{'show_custom_regeneration_name': True}"/>
                                                <field name="therapy_amount" invisible="not show_unit_amount"
                                                       readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="pos_qty" invisible="quantity_mode == 'hidden'"
                                                       readonly="quantity_mode == 'fixed'"/>
                                                <field name="used_sessions" invisible="1"/>
                                                <field name="total_amount" invisible="not show_total_amount"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="notes" placeholder="Add internal notes here..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollment</field>
        <field name="res_model">patient.enrollment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'show_custom_regeneration_name': True}</field>
    </record>
</odoo>