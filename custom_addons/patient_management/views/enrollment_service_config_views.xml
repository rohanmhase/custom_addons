<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_enrollment_service_config_tree" model="ir.ui.view">
        <field name="name">patient.enrollment.service.config.tree</field>
        <field name="model">patient.enrollment.service.config</field>
        <field name="arch" type="xml">
            <tree string="Enrollment Service Configuration">
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="service_category"/>
                <field name="counts_as_sessions"/>
                <field name="quantity_mode"/>
                <field name="default_quantity"/>
                <field name="activity_window_days"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_enrollment_service_config_form" model="ir.ui.view">
        <field name="name">patient.enrollment.service.config.form</field>
        <field name="model">patient.enrollment.service.config</field>
        <field name="arch" type="xml">
            <form string="Enrollment Service Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="service_category"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="counts_as_sessions"/>
                            <field name="activity_window_days"
                                   invisible="service_category not in ['therapy', 'medicine']"/>
                            <field name="display_name_override"/>
                        </group>
                    </group>

                    <group string="Quantity Behavior">
                        <group>
                            <field name="quantity_mode"/>
                            <field name="default_quantity"/>
                            <field name="require_positive_quantity"/>
                        </group>
                        <group>
                            <field name="show_total_amount"/>
                            <field name="show_unit_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_enrollment_service_config" model="ir.actions.act_window">
        <field name="name">Enrollment Service Configuration</field>
        <field name="res_model">patient.enrollment.service.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure how each POS service behaves in patient enrollment.
            </p>
            <p>
                Add a configuration here when a new service is introduced. No Python change is required.
            </p>
        </field>
    </record>

    <menuitem id="menu_enrollment_service_config"
              name="Enrollment Service Configuration"
              parent="clinic_management.menu_clinic_root"
              action="action_enrollment_service_config"
              groups="clinic_management.group_clinic_administrator"
              sequence="90"/>
</odoo>
