<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_whatsapp_message_queue_tree" model="ir.ui.view">
        <field name="name">whatsapp.message.queue.tree</field>
        <field name="model">whatsapp.message.queue</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Messages"
                  decoration-success="state == 'sent'"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'pending'"
                  create="false">
                <field name="create_date" string="Created On"/>
                <field name="smartchat_template_name" string="Template"/>
                <field name="patient_name"/>
                <field name="phone"/>
                <field name="wamid" string="Meta Message ID" optional="show"/>
                <field name="sent_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'pending'"/>
                <button name="action_retry" type="object" string="Retry"
                        class="btn-link" icon="fa-refresh"
                        invisible="state != 'error'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_whatsapp_message_queue_form" model="ir.ui.view">
        <field name="name">whatsapp.message.queue.form</field>
        <field name="model">whatsapp.message.queue</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message" create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="oe_highlight" invisible="state != 'error'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Recipient &amp; Delivery">
                            <field name="patient_name" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="wamid" readonly="1"/>
                        </group>
                        <group string="Routing &amp; Template">
                            <field name="smartchat_template_name" readonly="1"/>
                            <field name="broadcast_name" readonly="1"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluated Parameters (JSON)">
                            <field name="params_json" readonly="1"/>
                        </page>
                        <page string="Message Preview">
                            <field name="message_body" readonly="1"/>
                        </page>
                        <page string="Error Log" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_whatsapp_message_queue_search" model="ir.ui.view">
        <field name="name">whatsapp.message.queue.search</field>
        <field name="model">whatsapp.message.queue</field>
        <field name="arch" type="xml">
            <search string="Search Messages">
                <field name="patient_name"/>
                <field name="phone"/>
                <field name="smartchat_template_name"/>
                <field name="wamid"/>
                <field name="invoice_number"/>
                <separator/>
                <filter string="Bills &amp; Invoices" name="filter_invoices"
                        domain="[('res_model', '=', 'account.move')]"/>
                <filter string="Clinic Appointments" name="filter_appointments"
                        domain="[('res_model', '=', 'clinic.schedule.appointment')]"/>
                <separator/>
                <filter string="Pending" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Sent" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Failed" name="filter_error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Template" name="group_by_template" context="{'group_by': 'smartchat_template_name'}"/>
                    <filter string="Source Document" name="group_by_model" context="{'group_by': 'res_model'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Sent Date" name="group_by_sent_date" context="{'group_by': 'sent_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_whatsapp_message_queue" model="ir.actions.act_window">
        <field name="name">WhatsApp Queue</field>
        <field name="res_model">whatsapp.message.queue</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_whatsapp_message_queue_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <!-- Menus (Declared before child menus in template views) -->
    <menuitem id="menu_whatsapp_root" name="WhatsApp" sequence="65"/>
    <menuitem id="menu_whatsapp_queue" name="Message Queue" parent="menu_whatsapp_root"
              action="action_whatsapp_message_queue" sequence="10"/>
</odoo>