<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">whatsapp.template.tree</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <tree string="Meta WhatsApp Templates">
                <field name="name"/>
                <field name="meta_template_name"/>
                <field name="model_id"/>
                <field name="sender_phone_id" string="Sender Line"/>
                <field name="dispatch_timing" widget="badge"/>
                <field name="auto_send_on_post" widget="boolean_toggle" string="Auto-Send"/>
                <field name="action_server_id" widget="boolean" string="Action Menu Active"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="Meta WhatsApp Template">
                <header>
                    <button name="action_create_action"
                            string="Add to Action Menu"
                            type="object"
                            class="oe_highlight"
                            invisible="action_server_id"/>
                    <button name="action_remove_action"
                            string="Remove from Action Menu"
                            type="object"
                            invisible="not action_server_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Internal Name"/>
                        <h1><field name="name" placeholder="e.g. Patient Invoice Receipt"/></h1>
                    </div>
                    <group>
                        <group string="Meta Template &amp; Model">
                            <field name="meta_template_name" placeholder="e.g. patient_invoice_receipt"/>
                            <field name="language_code" placeholder="e.g. en"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model" invisible="1"/>
                            <field name="phone_field" placeholder="partner_id.mobile,partner_id.phone"/>
                            <field name="action_server_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Sender Line Routing">
                            <field name="sender_routing"/>
                            <field name="sender_phone_id"
                                   invisible="sender_routing != 'template'"
                                   required="sender_routing == 'template'"/>
                        </group>
                    </group>

                    <group string="Time &amp; Dispatch Scheduling">
                        <group string="Dispatch Trigger">
                            <field name="dispatch_timing"/>
                            <field name="auto_send_on_post"/>
                        </group>
                        <group string="Timing Parameters">
                            <!-- 1. Relative Delay -->
                            <label for="delay_value" string="Delay Duration" invisible="dispatch_timing != 'relative_delay'"/>
                            <div class="d-flex align-items-center gap-2" invisible="dispatch_timing != 'relative_delay'">
                                <span>Send</span>
                                <field name="delay_value" class="oe_inline" style="max-width: 80px;"/>
                                <field name="delay_unit" class="oe_inline" style="max-width: 110px;"/>
                                <span>after trigger</span>
                            </div>

                            <!-- 2. Fixed Time of Day -->
                            <label for="time_of_day_hour" string="Target Time" invisible="dispatch_timing != 'time_of_day'"/>
                            <div class="d-flex align-items-center gap-2" invisible="dispatch_timing != 'time_of_day'">
                                <span>Send at</span>
                                <field name="time_of_day_hour" widget="float_time" class="oe_inline" style="max-width: 90px;"/>
                                <span class="ms-2">(Day offset:</span>
                                <field name="time_of_day_offset_days" class="oe_inline" style="max-width: 60px;"/>
                                <span>days)</span>
                            </div>

                            <!-- 3. Record Datetime Offset -->
                            <field name="record_date_field" placeholder="e.g. start_datetime" invisible="dispatch_timing != 'field_offset'"/>
                            <label for="record_offset_value" string="Offset Rule" invisible="dispatch_timing != 'field_offset'"/>
                            <div class="d-flex align-items-center gap-2" invisible="dispatch_timing != 'field_offset'">
                                <field name="record_offset_value" class="oe_inline" style="max-width: 60px;"/>
                                <field name="record_offset_unit" class="oe_inline" style="max-width: 100px;"/>
                                <field name="record_offset_direction" class="oe_inline" style="max-width: 100px;"/>
                                <span>scheduled slot</span>
                            </div>
                        </group>
                    </group>

                    <group string="Media &amp; Document Header">
                        <group>
                            <field name="header_type"/>
                            <field name="header_document_url"
                                   invisible="header_type != 'document'"
                                   placeholder="{{ base_url }}/report/pdf/..."/>
                            <field name="header_document_filename"
                                   invisible="header_type != 'document'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Dynamic Parameters ({{1}}, {{2}}...)">
                            <p class="text-muted small">
                                Positional parameter expressions. Variables:
                                <code>{{ object.field }}</code>, <code>{{ clinic.name }}</code>, <code>{{ clinic.phone }}</code>, <code>{{ format_date(...) }}</code>, <code>{{ format_datetime(...) }}</code>, and <code>{{ base_url }}</code>.
                            </p>
                            <field name="param_ids">
                                <tree editable="bottom">
                                    <field name="index" style="width: 80px;"/>
                                    <field name="name" placeholder="e.g. Patient Name, Amount"/>
                                    <field name="value_expression" placeholder="{{ clinic.phone }}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Message Preview / Fallback">
                            <field name="body_preview" placeholder="Preview description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Message Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_whatsapp_root" name="WhatsApp" sequence="65"/>
    <menuitem id="menu_whatsapp_template"
              name="Templates"
              parent="menu_whatsapp_root"
              action="action_whatsapp_template"
              sequence="20"/>
</odoo>