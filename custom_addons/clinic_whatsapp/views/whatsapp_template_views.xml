<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">whatsapp.template.tree</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Templates">
                <field name="name"/>
                <field name="smartchat_template_name"/>
                <field name="model_id"/>
                <field name="header_type"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Internal Name"/>
                        <h1><field name="name" placeholder="e.g. Appointment Confirmation"/></h1>
                    </div>
                    <group>
                        <group string="SmartChat API Identifiers">
                            <field name="smartchat_template_name" placeholder="e.g. newtemplate"/>
                            <field name="broadcast_name" placeholder="e.g. Appointment_Reminder"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model" invisible="1"/>
                            <field name="phone_field" placeholder="e.g. patient_id.phone"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Headers &amp; Interactive Buttons">
                            <field name="header_type"/>
                            <field name="header_media_url"
                                   invisible="header_type == 'none'"
                                   required="header_type != 'none'"
                                   placeholder="e.g. https://domain.com/banner.png"/>
                            <field name="has_button_url"/>
                            <field name="button_url_suffix"
                                   invisible="not has_button_url"
                                   required="has_button_url"
                                   placeholder="e.g. portal/invoice/{{ object.id }}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dynamic Parameters ({{1}}, {{2}}...)">
                            <p class="text-muted small">
                                Map positional variables in order matching your Meta-approved template. Expressions support
                                <code>{{ object.field_name }}</code>, <code>{{ format_datetime(...) }}</code>, and <code>{{ format_date(...) }}</code>.
                            </p>
                            <field name="param_ids">
                                <tree editable="bottom">
                                    <field name="index" style="width: 100px;"/>
                                    <field name="name" placeholder="e.g. Patient Name"/>
                                    <field name="value_expression" placeholder="{{ object.patient_id.name }}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Message Preview / Fallback">
                            <field name="body" placeholder="Informative text preview of what the message looks like..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Message Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_whatsapp_template"
              name="Templates"
              parent="menu_whatsapp_root"
              action="action_whatsapp_template"
              sequence="20"/>
</odoo>