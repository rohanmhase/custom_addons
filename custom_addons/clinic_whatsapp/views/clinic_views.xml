<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_clinic_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">clinic.clinic.form.inherit.whatsapp</field>
        <field name="model">clinic.clinic</field>
        <field name="inherit_id" ref="clinic_management.view_clinic_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="admin_name" placeholder="Clinic Admin Name"/>
                <field name="admin_phone" placeholder="e.g. 98201XXXXX"/>
                <field name="admin_name_2" placeholder="Clinic Admin 2 Name"/>
                <field name="admin_phone_2" placeholder="e.g. 98202XXXXX"/>
            </xpath>
        </field>
    </record>
</odoo>