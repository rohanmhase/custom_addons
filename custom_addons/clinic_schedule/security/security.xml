<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MODULE CATEGORY -->
    <record model="ir.module.category" id="module_category_clinic_schedule">
        <field name="name">Clinic Scheduling</field>
        <field name="description">Access rights for the Clinical Matrix Dashboard</field>
        <field name="sequence">10</field>
    </record>

    <!-- 1. VIEWER GROUP -->
    <record id="group_clinic_schedule_viewer" model="res.groups">
        <field name="name">Viewer (Read-Only Matrix)</field>
        <field name="category_id" ref="module_category_clinic_schedule"/>
    </record>

    <!-- 2. CLINIC ADMIN GROUP -->
    <record id="group_clinic_schedule_clinic_admin" model="res.groups">
        <field name="name">Clinic Admin (Manage Matrix)</field>
        <field name="category_id" ref="module_category_clinic_schedule"/>
        <!-- Admin inherits Viewer so they can see everything a Viewer sees -->
        <field name="implied_ids" eval="[(4, ref('group_clinic_schedule_viewer'))]"/>
    </record>

    <!-- 3. HR GROUP (No Matrix Access, strictly Therapist Directory) -->
    <record id="group_clinic_schedule_hr" model="res.groups">
        <field name="name">HR / Operations (Therapist Directory Only)</field>
        <field name="category_id" ref="module_category_clinic_schedule"/>
    </record>

    <!-- 4. MANAGER GROUP (Full Access) -->
    <record id="group_clinic_schedule_manager" model="res.groups">
        <field name="name">Manager (Full System Access)</field>
        <field name="category_id" ref="module_category_clinic_schedule"/>
        <!-- Manager inherits Admin AND HR powers -->
        <field name="implied_ids" eval="[(4, ref('group_clinic_schedule_clinic_admin')), (4, ref('group_clinic_schedule_hr'))]"/>
    </record>

    <!-- RECORD RULES (Database-Level Isolation) -->

    <!-- Rule: Clinic Admin Branch Isolation (Forces users to only see their allowed clinics) -->
    <record id="rule_clinic_schedule_appointment_clinic_admin" model="ir.rule">
        <field name="name">Clinic Admin: Branch Isolation</field>
        <field name="model_id" ref="model_clinic_schedule_appointment"/>
        <!-- Matches appointments to the clinics explicitly assigned to the user profile -->
        <field name="domain_force">['|', ('clinic_id', '=', False), ('clinic_id', 'in', user.clinic_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_schedule_clinic_admin')), (4, ref('group_clinic_schedule_viewer'))]"/>
    </record>

    <!-- Rule: Manager Bypass (Managers see all clinics) -->
    <record id="rule_clinic_schedule_appointment_manager" model="ir.rule">
        <field name="name">Manager: All Branches Bypass</field>
        <field name="model_id" ref="model_clinic_schedule_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_schedule_manager'))]"/>
    </record>
</odoo>