<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_clinic_schedule_dashboard_client" model="ir.actions.client">
        <field name="name">Clinic Matrix Dashboard</field>
        <field name="tag">clinic_schedule.matrix_dashboard_action</field>
    </record>

    <!-- APPOINTMENT FORM VIEW -->
    <record id="view_clinic_schedule_appointment_form" model="ir.ui.view">
        <field name="name">clinic.schedule.appointment.form</field>
        <field name="model">clinic.schedule.appointment</field>
        <field name="arch" type="xml">
            <form string="Clinic Session">
                <header>
                    <button name="action_mark_completed" string="Mark Completed" type="object" class="btn-success" invisible="attendance_state in ['completed', 'no_show'] or is_future_session"/>
                    <button name="action_mark_no_show" string="Mark No-Show" type="object" class="btn-danger" invisible="attendance_state in ['completed', 'no_show'] or is_future_session"/>
                    <field name="attendance_state" widget="statusbar" statusbar_visible="scheduled,completed"/>
                </header>
                <sheet>
                    <field name="is_live_in_progress" invisible="1"/>
                    <field name="is_future_session" invisible="1"/>

                    <div invisible="not is_live_in_progress or attendance_state == 'completed'" class="alert alert-success text-center fw-bold text-uppercase shadow-sm" role="alert" style="border: 2px solid #28a745;">
                        <i class="fa fa-spinner fa-spin me-2"/> SESSION CURRENTLY IN PROGRESS
                    </div>

                    <div class="oe_title mb-4">
                        <h1><field name="name" placeholder="New Entry" readonly="1"/></h1>
                    </div>

                    <field name="has_existing_session" invisible="1"/>
                    <div invisible="not has_existing_session or slot_type != 'patient'" class="alert alert-info shadow-sm" role="alert">
                        <strong><i class="fa fa-info-circle me-1"/> Existing Session Today:</strong><br/>
                        <field name="existing_session_info" nolabel="1"/>
                    </div>

                    <group>
                        <group>
                            <field name="slot_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="visit_type" widget="radio" options="{'horizontal': True}" invisible="slot_type != 'patient'"/>
                            <field name="clinic_id" options="{'no_create': True}"/>
                            <field name="therapist_id" options="{'no_create': True}" domain="['|', ('allowed_branch_ids', '=', False), ('allowed_branch_ids', 'in', clinic_id)]"/>
                        </group>
                        <group>
                            <field name="allowed_patient_ids" invisible="1"/>
                            <field name="patient_id" options="{'no_create': True}" invisible="slot_type != 'patient'" required="slot_type == 'patient'" domain="[('id', 'in', allowed_patient_ids)]"/>

                            <!-- 12-Hour AM/PM Enforcement -->
                            <field name="start_datetime" widget="datetime" options="{'format': 'yyyy-MM-dd hh:mm a'}"/>
                            <field name="end_datetime" readonly="1" force_save="1" widget="datetime" options="{'format': 'yyyy-MM-dd hh:mm a'}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- THERAPIST KANBAN VIEW (Modern Directory Look) -->
    <record id="view_clinic_therapist_kanban" model="ir.ui.view">
        <field name="name">clinic.therapist.kanban</field>
        <field name="model">clinic.therapist</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="designation"/>
                <field name="vendor_id"/>
                <field name="image_128"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record border-0 shadow-sm rounded mb-3">
                            <field name="image_128" widget="image" class="o_kanban_image_fill_left" options="{'zoom': true, 'background': true, 'preventClicks': false}"/>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title fs-5">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <ul class="mt-2 list-unstyled text-muted small">
                                    <li t-if="record.designation.raw_value" class="o_text_overflow mb-1">
                                        <i class="fa fa-briefcase me-1" title="Briefcase"/> <field name="designation"/>
                                    </li>
                                    <li t-if="record.vendor_id.raw_value" class="o_text_overflow">
                                       <i class="fa fa-id-badge me-1" title="Badge"/> <field name="vendor_id"/>
                                    </li>
                                </ul>
                                <div class="o_kanban_record_bottom mt-auto d-flex justify-content-between">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'onboarding'" decoration-danger="state == 'offboarded'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

<!-- THERAPIST TREE VIEW (Cleaned) -->
    <record id="view_clinic_therapist_tree" model="ir.ui.view">
        <field name="name">clinic.therapist.tree</field>
        <field name="model">clinic.therapist</field>
        <field name="arch" type="xml">
            <tree string="Therapists" decoration-muted="state == 'offboarded'">
                <field name="name" class="fw-bold"/>
                <field name="vendor_id"/>
                <field name="contact_number"/>
                <field name="designation" widget="badge" decoration-info="designation == 'floater'" decoration-success="designation == 'hv'" decoration-primary="designation == 'fixed'"/>
                <field name="allowed_branch_ids" widget="many2many_tags" optional="show"/>
                <field name="is_buffer" widget="boolean_toggle" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'onboarding'" decoration-danger="state == 'offboarded'"/>
            </tree>
        </field>
    </record>

    <!-- THERAPIST FORM VIEW (HR Onboarding Layout) -->
    <record id="view_clinic_therapist_form" model="ir.ui.view">
        <field name="name">clinic.therapist.form</field>
        <field name="model">clinic.therapist</field>
        <field name="arch" type="xml">
            <form string="Therapist Profile">
                <header>
                    <button name="action_activate" string="Complete Onboarding" type="object" class="oe_highlight btn-success" invisible="state != 'onboarding'"/>
                    <button name="action_offboard" string="Offboard Therapist" type="object" class="btn-danger" invisible="state == 'offboarded'"/>
                    <button name="action_reonboard" string="Re-onboard Therapist" type="object" class="btn-warning" invisible="state != 'offboarded'"/>
                    <field name="state" widget="statusbar" statusbar_visible="onboarding,active,offboarded"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Offboarded" bg_color="bg-secondary" invisible="state != 'offboarded'"/>

                    <field name="image_1920" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image':'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Therapist Name"/>
                        <h1><field name="name" placeholder="e.g. Jane Doe" required="1"/></h1>
                    </div>

                    <group>
                        <group string="Employment Details">
                            <field name="designation" widget="radio" options="{'horizontal': True}"/>
                            <field name="vendor_id"/>
                            <field name="base_branch_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                            <field name="is_buffer" widget="boolean_toggle"/>
                            <field name="allowed_branch_ids" widget="many2many_tags" placeholder="Assign operating clinics..."/>
                        </group>
                        <group string="Personal Information">
                            <field name="contact_number" widget="phone"/>
                            <field name="gender" widget="radio" options="{'horizontal': True}"/>
                            <field name="transport_type"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="HR &amp; Bank Details">
                            <group>
                                <group string="Compensation">
                                    <field name="hourly_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <group string="Bank Account Information">
                                    <field name="bank_account_name" placeholder="Account Holder Name"/>
                                    <field name="bank_name" placeholder="e.g. HDFC Bank"/>
                                    <field name="bank_account_number" placeholder="Account Number"/>
                                    <field name="bank_ifsc_code" placeholder="IFSC Code"/>
                                </group>
                            </group>
                        </page>
                        <page string="Documents &amp; Exit">
                            <div class="container-fluid mt-3 mb-4">
                                <h5 class="text-primary fw-bold mb-3"><i class="fa fa-folder-open-o me-2"/>KYC &amp; Identity Documents</h5>

                                <div class="row">
                                    <!-- Aadhaar Card Box -->
                                    <div class="col-md-6 mb-3">
                                        <div class="card shadow-sm border-0 bg-light h-100">
                                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                                <i class="fa fa-id-card fa-3x text-secondary mb-3"/>
                                                <h6 class="fw-bold text-dark mb-1">Aadhaar Document</h6>
                                                <p class="text-muted small mb-3">Accepts PDF, JPG, PNG, etc.</p>

                                                <field name="aadhaar_filename" invisible="1"/>
                                                <field name="aadhaar_document" filename="aadhaar_filename" widget="binary" nolabel="1" class="w-100 fw-bold text-primary"/>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- PAN Card Box -->
                                    <div class="col-md-6 mb-3">
                                        <div class="card shadow-sm border-0 bg-light h-100">
                                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                                <i class="fa fa-credit-card fa-3x text-secondary mb-3"/>
                                                <h6 class="fw-bold text-dark mb-1">PAN Document</h6>
                                                <p class="text-muted small mb-3">Accepts PDF, JPG, PNG, etc.</p>

                                                <field name="pan_filename" invisible="1"/>
                                                <field name="pan_document" filename="pan_filename" widget="binary" nolabel="1" class="w-100 fw-bold text-primary"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info shadow-sm mt-3 border-info" role="alert" style="border-left: 4px solid #0dcaf0;">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>Need to add more files?</strong> Please upload multi-page contracts, compliance forms, or other certifications directly into the chatter panel on the right.
                                </div>
                            </div>

                            <!-- Exit Information (Only visible if offboarded) -->
                            <group string="Exit Information" invisible="state != 'offboarded'" class="mt-4">
                                <field name="leaving_date" readonly="1"/>
                                <field name="leaving_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Advanced Search for the Ledger -->
    <record id="view_clinic_schedule_appointment_search" model="ir.ui.view">
        <field name="name">clinic.schedule.appointment.search</field>
        <field name="model">clinic.schedule.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="patient_id"/>
                <field name="therapist_id" string="Scheduled Therapist"/>
                <field name="actual_therapist_id" string="Actual Therapist"/>
                <field name="clinic_id"/>
                <field name="name" string="Appointment ID"/>

                <filter string="Completed" name="completed" domain="[('attendance_state', '=', 'completed')]"/>
                <filter string="No-Show" name="noshow" domain="[('attendance_state', '=', 'no_show')]"/>
                <separator/>
                <filter string="Therapist Mismatch" name="mismatch" domain="[('is_therapist_mismatch', '=', True)]"/>
                <filter string="Manually Forced" name="forced" domain="[('manual_completion_user_id', '!=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Date" name="group_date" context="{'group_by':'start_datetime:day'}"/>
                    <filter string="Clinic" name="group_clinic" context="{'group_by':'clinic_id'}"/>
                    <filter string="Scheduled Therapist" name="group_therapist" context="{'group_by':'therapist_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'attendance_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Upgraded Global List View -->
    <record id="view_clinic_schedule_appointment_tree" model="ir.ui.view">
        <field name="name">clinic.schedule.appointment.tree</field>
        <field name="model">clinic.schedule.appointment</field>
        <field name="arch" type="xml">
            <tree string="All Appointments" create="false" edit="false" delete="false" default_order="start_datetime desc"
                  decoration-success="attendance_state == 'completed'"
                  decoration-danger="attendance_state == 'no_show'"
                  decoration-info="attendance_state == 'in_progress'">
                <field name="name" string="Ref"/>
                <field name="start_datetime"/>
                <field name="clinic_id"/>
                <field name="patient_id"/>
                <field name="therapist_id" string="Scheduled Therapist"/>
                <field name="actual_therapist_id" optional="show" string="Actual Therapist"/>
                <field name="is_therapist_mismatch" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="manual_completion_user_id" optional="hide"/>
                <field name="attendance_state" widget="badge"
                       decoration-success="attendance_state == 'completed'"
                       decoration-danger="attendance_state == 'no_show'"
                       decoration-info="attendance_state == 'in_progress'"/>
            </tree>
        </field>
    </record>

    <!-- Dedicated Read-Only Form for the Ledger -->
    <record id="view_clinic_schedule_appointment_ledger_form" model="ir.ui.view">
        <field name="name">clinic.schedule.appointment.ledger.form</field>
        <field name="model">clinic.schedule.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment Audit" create="false" edit="false" delete="false">
                <header>
                    <field name="attendance_state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Mismatch" bg_color="text-bg-danger" invisible="not is_therapist_mismatch"/>
                    <widget name="web_ribbon" title="Forced" bg_color="text-bg-warning" invisible="not manual_completion_user_id"/>

                    <div class="oe_title mb-4">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Core Details">
                            <field name="patient_id" readonly="1"/>
                            <field name="clinic_id" readonly="1"/>
                            <field name="slot_type" readonly="1"/>
                            <field name="visit_type" readonly="1"/>
                        </group>
                        <group string="Schedule &amp; Execution">
                            <field name="start_datetime" readonly="1"/>
                            <field name="end_datetime" readonly="1"/>
                            <field name="therapist_id" readonly="1" string="Scheduled Therapist"/>
                            <field name="actual_therapist_id" readonly="1" invisible="not actual_therapist_id"/>
                        </group>
                    </group>
                    <group string="Audit Flags" invisible="not is_therapist_mismatch and not manual_completion_user_id">
                        <field name="is_therapist_mismatch" readonly="1" invisible="not is_therapist_mismatch"/>
                        <field name="manual_completion_user_id" readonly="1" invisible="not manual_completion_user_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Window Action: Strict Binding to Ledger Views -->
    <record id="action_clinic_appointment_ledger" model="ir.actions.act_window">
        <field name="name">Global Appointment Ledger</field>
        <field name="res_model">clinic.schedule.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_clinic_schedule_appointment_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_clinic_schedule_appointment_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinic_schedule_appointment_ledger_form')})
        ]"/>
        <field name="context">{'search_default_group_date': 1}</field>
    </record>

    <record id="view_clinic_therapist_offboard_wizard" model="ir.ui.view">
        <field name="name">clinic.therapist.offboard.wizard.form</field>
        <field name="model">clinic.therapist.offboard.wizard</field>
        <field name="arch" type="xml">
            <form string="Offboard Therapist">
                <group>
                    <field name="leaving_date"/>
                    <field name="leaving_reason" placeholder="e.g., Resigned, contract ended..."/>
                </group>
                <footer>
                    <button string="Confirm Offboarding" name="action_confirm_offboard" type="object" class="btn-danger fw-bold"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Add to your existing top menu under 'Appointments Dashboard' -->
    <menuitem id="menu_schedule_appointment_ledger"
              name="Global Appointment Ledger"
              parent="menu_clinic_schedule_root"
              action="action_clinic_appointment_ledger"
              sequence="12"
              groups="clinic_schedule.group_clinic_schedule_manager"/>

    <record id="view_clinic_manual_complete_wizard" model="ir.ui.view">
        <field name="name">clinic.manual.complete.wizard</field>
        <field name="model">clinic.manual.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Force Completion">
                <div class="alert alert-warning text-center border-warning shadow-sm" role="alert">
                    <i class="fa fa-exclamation-triangle fa-3x mb-2 text-warning"></i>
                    <h5 class="fw-bold text-dark">No Backend Therapy Found!</h5>
                    <p class="mb-0 text-dark">We could not find an active therapy session record for this patient today. Are you sure you want to force mark this schedule slot as completed?</p>
                </div>
                <footer>
                    <button string="Force Complete" name="action_confirm" type="object" class="btn-danger fw-bold"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

<!--     FLOATER REQUEST WIZARD FORM -->
    <record id="view_clinic_floater_request_wizard_form" model="ir.ui.view">
        <field name="name">clinic.floater.request.wizard.form</field>
        <field name="model">clinic.floater.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Floater Therapist">
                <sheet>
                    <div class="alert alert-info text-center" role="alert">
                        <i class="fa fa-check-circle fa-2x mb-2" title="Success"/><br/>
                        <strong>Capacity Met:</strong> You are eligible to request a floater.<br/>
                        Please select the required gender for this floater.
                        <br/><small>(Max limit: 3 requests per gender, per day)</small>
                    </div>
                    <group>
                        <field name="clinic_id" readonly="1" options="{'no_open': True}"/>
                        <field name="target_date" readonly="1"/>
                        <field name="gender" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit_request" type="object" string="Submit Request" class="btn-primary fw-bold" icon="fa-paper-plane"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_clinic_therapist_directory" model="ir.actions.act_window">
        <field name="name">Master Therapist Directory</field>
        <field name="res_model">clinic.therapist</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Therapist profile!
            </p>
            <p>
                Onboard new clinicians and manage their branch deployment and banking information here.
            </p>
        </field>
    </record>




    <!-- ROSTER IMPORT LOG VIEWS -->
    <record id="view_clinic_therapist_import_log_form" model="ir.ui.view">
        <field name="name">clinic.therapist.import.log.form</field>
        <field name="model">clinic.therapist.import.log</field>
        <field name="arch" type="xml">
            <form string="Import Roster Spreadsheet">
                <header>
                    <button name="action_process_csv" type="object" string="Execute Roster Sync" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Spreadsheet Selection">
                            <field name="csv_file" filename="file_name" widget="binary"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group string="Audit Parameters">
                            <field name="execution_date"/>
                            <field name="records_processed" invisible="state == 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_clinic_therapist_import_log_tree" model="ir.ui.view">
        <field name="name">clinic.therapist.import.log.tree</field>
        <field name="model">clinic.therapist.import.log</field>
        <field name="arch" type="xml">
            <tree string="Import History">
                <field name="execution_date"/>
                <field name="file_name"/>
                <field name="records_processed"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="action_clinic_therapist_import_log" model="ir.actions.act_window">
        <field name="name">Upload Staff Roster</field>
        <field name="res_model">clinic.therapist.import.log</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>