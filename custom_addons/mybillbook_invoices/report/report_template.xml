<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_mybillbook_invoice_template">
        <t t-call="web.html_container">
            <style>
                .bb-page, .bb-page table, .bb-page td, .bb-page th { font-family: Roboto, "Liberation Sans", Arial, sans-serif; font-size: 17px; color: #000; }
                .bb-rs:before { content: "\20B9\00a0"; }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-set="note_text" t-value="doc.notes or (doc.payment_mode and ('Paid by %s' % doc.payment_mode)) or ''"/>
                <t t-set="logo_uri" t-value="doc._get_logo_uri()"/>
                <div class="page bb-page" style="padding: 0;">

                    <div style="font-size: 16px; font-weight: bold; margin-bottom: 22px;">
                        BILL OF SUPPLY
                        <span style="border: 1px solid #999; color: #666; padding: 2px 7px; margin-left: 8px; font-weight: normal; font-size: 16px;">ORIGINAL FOR RECIPIENT</span>
                    </div>

                    <!-- HEADER: logo | name / address / mobile + gstin -->
                    <table style="width:100%; border-collapse: collapse; margin-bottom: 17px; table-layout: fixed;">
                        <tr>
                            <td style="width: 198px; vertical-align: top; padding: 0;">
                                <img t-att-src="logo_uri" style="max-width: 160px; max-height: 160px; margin-left: 11px;"/>
                            </td>
                            <td style="vertical-align: top; padding: 30px 0 0 0;">
                                <div style="font-size: 32px; font-weight: bold; line-height: 1.1; margin-bottom: 10px;">
                                    <span t-esc="doc.clinic_name"/>
                                </div>
                                <t t-if="doc.clinic_id">
                                    <div t-if="doc.clinic_id.address" style="font-size: 16.5px; line-height: 1.15; margin-bottom: 5px; white-space: pre-line;"><span t-esc="doc.clinic_id.address"/></div>
                                    <div style="font-size: 16.5px; line-height: 1.3;">
                                        <span t-if="doc.clinic_id.mobile" style="margin-right: 34px;"><strong style="margin-right: 5px;">Mobile:</strong><span t-esc="doc.clinic_id.mobile"/></span>
                                        <span t-if="doc.clinic_id.gstin"><strong style="margin-right: 5px;">GSTIN:</strong><span t-esc="doc.clinic_id.gstin"/></span>
                                    </div>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- THICK BAR + INVOICE BAND -->
                    <div style="height: 10px; background: #000;"></div>
                    <table style="width:100%; border-collapse: collapse; background:#e8e8e8; margin-bottom: 6px;">
                        <tr>
                            <td style="padding: 23px 21px; font-weight: bold;">Invoice No.: <span style="font-weight: normal;" t-esc="doc.invoice_no"/></td>
                            <td style="padding: 23px 21px; font-weight: bold; text-align: right;">
                                Invoice Date: <span style="font-weight: normal;" t-if="doc.date" t-esc="doc.date.strftime('%d/%m/%Y')"/>
                            </td>
                        </tr>
                    </table>

                    <!-- BILL TO / SHIP TO -->
                    <table style="width:100%; border-collapse: collapse; margin-bottom: 16px;">
                        <tr>
                            <td style="width:50%; vertical-align:top; padding: 0 1px;">
                                <div style="font-weight:bold; margin-bottom: 8px;">BILL TO</div>
                                <div style="font-weight:bold; margin-bottom: 6px;"><span t-esc="doc.party_name"/></div>
                                <div t-if="doc.party_mobile" style="font-size: 16px; margin-bottom: 4px;">Mobile: <span t-esc="doc.party_mobile"/></div>
                                <div style="font-size: 16px;">Place of Supply: Maharashtra</div>
                            </td>
                            <td style="width:50%; vertical-align:top; padding: 0 1px;">
                                <div style="font-weight:bold; margin-bottom: 8px;">SHIP TO</div>
                                <div style="font-weight:bold;"><span t-esc="doc.party_name"/></div>
                            </td>
                        </tr>
                    </table>

                    <!-- ITEMS -->
                    <table style="width:100%; border-collapse: collapse; table-layout: fixed;">
                        <thead>
                            <tr style="border-top:2px solid #000; border-bottom:2px solid #000;">
                                <th style="text-align:left; padding:18px 10px; font-weight:bold;">ITEMS</th>
                                <th style="text-align:center; padding:18px 10px; width:13%; font-weight:bold;">QTY.</th>
                                <th style="text-align:right; padding:18px 10px; width:12%; font-weight:bold;">RATE</th>
                                <th style="text-align:right; padding:18px 10px; width:22%; font-weight:bold;">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.line_ids" t-as="line" style="border-bottom:1px solid #ddd;">
                                <td style="padding:11px 10px; text-transform:uppercase;"><span t-esc="line.item_name"/></td>
                                <td style="text-align:center; padding:11px 10px; text-transform:uppercase;"><span t-esc="line.quantity_display"/></td>
                                <td style="text-align:right; padding:11px 10px;"><span t-esc="'{:,.0f}'.format(line.rate)"/></td>
                                <td style="text-align:right; padding:11px 10px;"><span t-esc="'{:,.0f}'.format(line.amount)"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="height: 150px;"></div>

                    <!-- SUBTOTAL -->
                    <table style="width:100%; border-collapse:collapse; table-layout: fixed; border-top:2px solid #000; border-bottom:2px solid #000; margin:0 0 18px 0;">
                        <tr>
                            <td style="padding:10px 10px; font-weight:bold;">SUBTOTAL</td>
                            <td style="text-align:center; padding:10px 10px; font-weight:bold; width:13%;"><span t-esc="'{:g}'.format(doc.total_qty)"/></td>
                            <td style="width:12%;"></td>
                            <td style="text-align:right; padding:10px 10px; font-weight:bold; width:22%;">
                                <span class="bb-rs"/><span t-esc="'{:,.0f}'.format(doc.total_amount)"/>
                            </td>
                        </tr>
                    </table>

                    <!-- FOOTER -->
                    <table style="width:100%; table-layout: fixed; border-collapse: collapse;">
                        <tr>
                            <td style="width:65%; vertical-align:top; padding: 0 0 0 10px;">
                                <div style="width: 73%;">
                                    <t t-if="note_text">
                                        <div style="font-weight:bold; margin-bottom:4px;">NOTES</div>
                                        <div style="margin-bottom:16px; white-space:pre-line;"><span t-esc="note_text"/></div>
                                    </t>
                                    <t t-if="doc.clinic_id and doc.clinic_id.bank_name">
                                        <div style="font-weight:bold; margin-bottom:2px;">BANK DETAILS</div>
                                        <table style="margin-bottom:24px; border-collapse: collapse;">
                                            <tr><td style="padding:3px 0; width:145px;">Name:</td><td><span t-esc="doc.clinic_id.bank_holder_name or doc.clinic_name"/></td></tr>
                                            <tr><td style="padding:3px 0;">IFSC Code:</td><td><span t-esc="doc.clinic_id.bank_ifsc"/></td></tr>
                                            <tr><td style="padding:3px 0;">Account No:</td><td><span t-esc="doc.clinic_id.bank_account"/></td></tr>
                                            <tr><td style="padding:3px 0;">Bank:</td><td><span t-esc="doc.clinic_id.bank_name"/></td></tr>
                                        </table>
                                    </t>
                                    <div style="font-weight:bold; margin-bottom:5px;">TERMS AND CONDITIONS</div>
                                    <div style="line-height:1.18;">1. Goods once sold will not be taken back or exchanged<br/>
                                    2. All disputes are subject to Thane Naupada jurisdiction only</div>
                                </div>
                            </td>
                            <td style="width:35%; vertical-align:top; padding: 0;">
                                <div style="border-top:1px solid #999;"></div>
                                <table style="width:100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="text-align:right; padding:8px 0; font-weight:bold; border-bottom:1px solid #999;">Total Amount</td>
                                        <td style="text-align:right; padding:8px 0; font-weight:bold; width:140px; border-bottom:1px solid #999;"><span class="bb-rs"/><span t-esc="'{:,.0f}'.format(doc.total_amount)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:right; padding:9px 0 2px 0;">Received Amount</td>
                                        <td style="text-align:right; padding:9px 0 2px 0;"><span class="bb-rs"/><span t-esc="'{:,.0f}'.format(doc.total_amount)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:right; padding:3px 0; font-weight:bold;">Balance</td>
                                        <td style="text-align:right; padding:3px 0; font-weight:bold;"><span class="bb-rs"/>0</td>
                                    </tr>
                                </table>
                                <div style="margin-top:26px; text-align:right; padding-right:10px;">
                                    <div style="font-weight:bold; margin-bottom:4px;">Total Amount (in words)</div>
                                    <div><span t-esc="doc.amount_in_words"/></div>
                                </div>
                            </td>
                        </tr>
                    </table>

                </div>
                <p t-if="not doc_last" style="page-break-after: always;"/>
            </t>
        </t>
    </template>
</odoo>
