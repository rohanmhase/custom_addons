<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_mybillbook" model="report.paperformat">
        <field name="name">My Bill Book A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">4</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_mybillbook_invoice" model="ir.actions.report">
        <field name="name">Invoices</field>
        <field name="model">mybillbook.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mybillbook_invoices.report_mybillbook_invoice_template</field>
        <field name="report_file">mybillbook_invoices.report_mybillbook_invoice_template</field>
        <field name="print_report_name">object.pdf_filename()</field>
        <field name="paperformat_id" ref="paperformat_mybillbook"/>
        <field name="binding_model_id" ref="model_mybillbook_invoice"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
