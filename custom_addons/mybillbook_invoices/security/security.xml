<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mybillbook" model="ir.module.category">
        <field name="name">My Bill Book</field>
        <field name="description">Access levels for Legacy Invoices</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_mybillbook_user" model="res.groups">
        <field name="name">User (Read Only)</field>
        <field name="category_id" ref="module_category_mybillbook"/>
    </record>

    <record id="group_mybillbook_moderator" model="res.groups">
        <field name="name">Moderator</field>
        <field name="category_id" ref="module_category_mybillbook"/>
        <field name="implied_ids" eval="[(4, ref('group_mybillbook_user'))]"/>
    </record>

    <record id="group_mybillbook_admin" model="res.groups">
        <field name="name">Administrator (Config, Import &amp; Delete)</field>
        <field name="category_id" ref="module_category_mybillbook"/>
        <field name="implied_ids" eval="[(4, ref('group_mybillbook_moderator'))]"/>
    </record>
</odoo>
