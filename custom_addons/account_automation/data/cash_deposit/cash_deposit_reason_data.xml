<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="reason_cash_carry_forward" model="cash.deposit.audit.reason">
        <field name="name">Deposit Pending / Yet To Be Deposited</field>
        <field name="sequence">10</field>
        <field name="resolution_type">carry_forward</field>
        <field name="help_text">Cash not yet deposited into the bank — carry forward to next audit.</field>
    </record>

    <record id="reason_cash_settle_pending" model="cash.deposit.audit.reason">
        <field name="name">Settle Against Past Pending</field>
        <field name="sequence">20</field>
        <field name="resolution_type">settle_pending</field>
        <field name="help_text">Use to offset current variance with previously carried-forward gap(s).</field>
    </record>

    <record id="reason_cash_write_off" model="cash.deposit.audit.reason">
        <field name="name">Drop / Adjusted via Other Channel</field>
        <field name="sequence">30</field>
        <field name="resolution_type">write_off</field>
        <field name="help_text">Amount reconciled outside the system — no carry forward needed.</field>
    </record>

</odoo>